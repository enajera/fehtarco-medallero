// Prisma Schema - Sistema Medallero Federativo MVP
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum EventScope {
  NATIONAL_FEDERATION
  NATIONAL_INTERNATIONALIZED
  INTERNATIONAL_NATIONAL_TEAM
}

enum TechnicalLevel {
  WA_STANDARD
  INDOOR_STANDARD
  REDUCED
  DEVELOPMENT
}

enum Distance {
  FIVE_METERS        // 5m
  TEN_METERS         // 10m
  THIRTY_METERS      // 30m
  FIFTY_METERS       // 50m
  SEVENTY_METERS     // 70m
  INDOOR             // Indoor (18m)
}

enum BowType {
  RECURVE
  COMPOUND
  BAREBOW
}

enum Gender {
  M
  F
}

enum ModalityName {
  INDIVIDUAL
  TEAM
  MIXED
}

enum PhaseName {
  QUALIFICATION
  FINAL
  BRONZE_MATCH
}

enum UserRole {
  PUBLIC
  ADMIN
  SUPER_ADMIN
}

// ============================================
// MODELS
// ============================================

model Club {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  abbreviation String? 
  city      String?
  active    Boolean   @default(true)
  logoUrl   String?   // legacy field
  // Binary logo stored directly in DB (BYTEA) — served via GET /api/clubs/:id/logo
  logoData      Bytes?
  logoMimeType  String?
  
  athletes  Athlete[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("clubs")
}

model Athlete {
  id                    Int       @id @default(autoincrement())
  firstName             String
  lastName              String
  birthDate             DateTime?
  gender                Gender?
  clubId                Int?
  phone                 String?
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodType             String?
  bowType               BowType
  drawWeightLbs         Float?
  drawLengthIn          Float?
  active                Boolean   @default(true)
  photoUrl              String?
  // Binary photo data stored directly in database (BYTEA)
  photoData             Bytes?
  photoMimeType         String?    // e.g., "image/jpeg", "image/png"
  
  // Historial de clubes: [{ clubId: 1, clubName: "Kentauros", from: "2020-01-01", to: "2022-06-15" }, ...]
  clubHistory           Json      @default("[]")
  
  // Link to User account for self-registration and authentication (one-to-one)
  userId                Int?      @unique
  user                  User?     @relation(fields: [userId], references: [id])
  
  club                  Club?     @relation(fields: [clubId], references: [id])
  results               Result[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([clubId])
  @@index([lastName, firstName])
  @@map("athletes")
}

model Event {
  id                Int            @id @default(autoincrement())
  name              String
  organizer         String
  location          String
  country           String
  startDate         DateTime
  endDate           DateTime
  eventScope        EventScope
  technicalLevel    TechnicalLevel
  official          Boolean        @default(true)
  clubMedalsEnabled Boolean

  eventCategories   EventCategory[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([startDate])
  @@index([eventScope])
  @@index([technicalLevel])
  @@map("events")
}

model Category {
  id              Int      @id @default(autoincrement())
  bowType         BowType
  gender          Gender
  division        String   // Ej: "Senior", "Junior", "Cadete", "Master"

  eventCategories EventCategory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([bowType, gender, division])
  @@index([bowType, gender])
  @@map("categories")
}

model Modality {
  id    Int          @id @default(autoincrement())
  name  ModalityName @unique

  eventCategories EventCategory[]

  @@map("modalities")
}

model Phase {
  id         Int       @id @default(autoincrement())
  name       PhaseName @unique
  orderIndex Int

  results    Result[]

  @@map("phases")
}

model EventCategory {
  id          Int      @id @default(autoincrement())
  eventId     Int
  categoryId  Int
  modalityId  Int
  distance    Distance?    // Distance for this category within the event (e.g. 70m, 50m, 30m, INDOOR)
  phases      String[] @default([])  // Array of phase names (QUALIFICATION, ELIMINATION, SEMI_FINAL, BRONZE_MATCH, FINAL)

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
  modality    Modality @relation(fields: [modalityId], references: [id])

  results     Result[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, categoryId, modalityId])
  @@index([eventId])
  @@index([categoryId])
  @@index([distance])
  @@map("event_categories")
}

model Result {
  id              Int           @id @default(autoincrement())
  eventCategoryId Int
  phaseId         Int
  athleteId       Int
  score           Int
  position        Int
  notes           String?

  eventCategory   EventCategory @relation(fields: [eventCategoryId], references: [id], onDelete: Cascade)
  phase           Phase         @relation(fields: [phaseId], references: [id])
  athlete         Athlete       @relation(fields: [athleteId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@unique([eventCategoryId, phaseId, athleteId])
  @@index([athleteId])
  @@index([eventCategoryId, phaseId])
  // Suggested composite index to speed up common result queries and ordering by position
  @@index([eventCategoryId, phaseId, position])
  @@map("results")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  
  // Link to Athlete for self-registration
  athlete      Athlete?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
